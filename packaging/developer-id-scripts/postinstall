#!/bin/bash
# Native Installer upgrade: verify the new global plugins, then preserve/remove
# older per-user BASSBOXX duplicates so AU discovery reaches the signed edition.
set -euo pipefail
readonly team_id='5QF6Q5ATG5'
volume="${3:-/}"
for relative in Components/BASSBOXX.component VST3/BASSBOXX.vst3; do
 product="$volume/Library/Audio/Plug-Ins/$relative"
 /usr/bin/codesign --verify --deep --strict "$product"
 metadata="$(/usr/bin/codesign -dv --verbose=4 "$product" 2>&1)"
 printf '%s\n' "$metadata" | /usr/bin/grep -Fx "TeamIdentifier=$team_id" >/dev/null
 printf '%s\n' "$metadata" | /usr/bin/grep -F 'Authority=Developer ID Application:' >/dev/null
done
# An off-boot-volume install must not modify the current user's plugins.
[[ "$volume" == / ]] || exit 0
console_user="$(/usr/bin/stat -f %Su /dev/console)"
case "$console_user" in root|loginwindow|_mbsetupuser|'') exit 0;; esac
user_home="$(/usr/bin/dscacheutil -q user -a name "$console_user" | /usr/bin/awk '/^dir: / {sub(/^dir: /, ""); print; exit}')"
[[ "$user_home" == /* && "$user_home" != / ]] || { echo 'Cannot determine the logged-in user home for duplicate-plugin backup.'; exit 1; }
backup="$user_home/Library/Application Support/BASSBOXX/Backups/DeveloperID-$(date +%Y%m%d-%H%M%S)-$$"
for relative in Components/BASSBOXX.component VST3/BASSBOXX.vst3; do
 old="$user_home/Library/Audio/Plug-Ins/$relative"
 [[ -d "$old" ]] || continue
 identifier="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$old/Contents/Info.plist" 2>/dev/null || true)"
 [[ "$identifier" == com.prohoezak.bassboxx ]] || { echo "An unrelated bundle uses the BASSBOXX filename; it was left untouched: $old"; continue; }
 # Run home-folder changes as that user, never with root authority through a
 # user-controlled path or symlink. Original attributes/signatures are retained.
 /usr/bin/sudo -u "$console_user" /bin/mkdir -p "$backup"
 /usr/bin/sudo -u "$console_user" /bin/mv "$old" "$backup/${old##*/}"
 echo "Previous per-user plugin backed up: $backup/${old##*/}"
done
echo 'BASSBOXX AU and VST3 installed. Restart MPC, keep Use Audio Units enabled, and choose Rescan All. The standalone app was not changed.'
