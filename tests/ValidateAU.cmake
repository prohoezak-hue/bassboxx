# AU discovery is a separate process and uses Apple's real component registry.
if(NOT IS_DIRECTORY "${PLUGIN}")
 message(FATAL_ERROR "Installed AU component missing: ${PLUGIN}")
endif()
set(found FALSE)
foreach(attempt RANGE 1 20)
 execute_process(COMMAND /usr/bin/auval -a TIMEOUT 15 RESULT_VARIABLE listing_result OUTPUT_VARIABLE listing ERROR_VARIABLE listing_error)
 if("${listing_result}" STREQUAL "0" AND listing MATCHES "aumu[ \t]+BsBx[ \t]+PhZk")
  set(found TRUE)
  break()
 endif()
 execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 0.5)
endforeach()
if(NOT found)
 message(FATAL_ERROR "BASSBOXX AU not discovered by Apple's registry: ${listing_result}\n${listing}\n${listing_error}")
endif()
execute_process(COMMAND /usr/bin/auval -v aumu BsBx PhZk TIMEOUT 180 RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
message("${output}\n${errors}")
if(NOT "${result}" STREQUAL "0" OR NOT output MATCHES "AU VALIDATION SUCCEEDED")
 message(FATAL_ERROR "Apple AU validation failed or timed out: ${result}")
endif()
execute_process(COMMAND "${HOST_CHECK}" "${PLUGIN}" TIMEOUT 30 RESULT_VARIABLE host_result)
if(NOT "${host_result}" STREQUAL "0")
 message(FATAL_ERROR "Actual AU host loading failed or timed out: ${host_result}")
endif()
